# ─────────────────────────────────────────────────────────────────
# multi-currency-ledger — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (replace with your actual connection string)
DATABASE_URL=postgres://user:password@localhost:5432/multi_currency_ledger

# Exchange Rate Provider (optional — leave blank to use in-memory stub)
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest
